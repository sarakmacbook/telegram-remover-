# Get API_ID and API_HASH at https://my.telegram.org (API development tools).
# PHONE must include the country code, e.g. +855 for Cambodia.
API_ID=123456
API_HASH=0123456789abcdef0123456789abcdef
PHONE=+15551234567

# ---------------------------------------------------------------------------
# SQL history database (optional but recommended)
# ---------------------------------------------------------------------------
# Everything the tool does — guard decisions, cleanup runs, pause flag,
# allow-lists, cursors — is stored in SQL and purged after DB_RETENTION_DAYS.
# Any SQLAlchemy URL works:
#   sqlite:///telegram_remover.db          (default: a local file)
#   postgresql://user:pass@host/db         (Vercel Postgres, Neon, ...)
#   mysql://user:pass@host/db              (PlanetScale, ...)
# Leave unset on Vercel to stay fully stateless, or set it to store history.
# DATABASE_URL=sqlite:///telegram_remover.db
# Records older than this many days are deleted automatically (default 30 =
# every month). The bot's /purge and `python telegram_remover.py db purge`
# do the same on demand.
# DB_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Telegram bot: alerts + status commands (optional)
# ---------------------------------------------------------------------------
# 1) Create a bot with @BotFather and paste its token here.
# 2) Send the bot any message; `python bot.py` prints your chat id — paste it
#    below (comma-separated for several admins) and restart the bot.
# Optional custom/self-hosted Bot API root (default: https://api.telegram.org).
# The host must be reachable from this server; use the root URL, not /bot<TOKEN>.
# Sandboxes and firewalls that block api.telegram.org always fail the web UI's
# "Connect & send test alert" (the call is made by this server, not your
# browser); check it with `GET /api/bot_connect` or the card's "Check server".
# TELEGRAM_API_BASE=https://api.telegram.org
# If the host needs a proxy, the standard HTTPS_PROXY variable is honored.
# HTTPS_PROXY=http://proxy.example:3128
# The CLI/web app then push guard and cleanup alerts to this chat, and the
# bot answers /status, /recent, /runs, /pause, /resume, /purge and /db.
# For web-only alerts, you can instead connect a bot in the web UI; its token
# and chat ID are stored in that browser and do not configure the CLI bot.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=123456789
# Group/supergroup chat IDs are usually negative (for example -1001234567890).
# Set to 0 to keep storing history but send no notifications.
# TELEGRAM_NOTIFY=1
